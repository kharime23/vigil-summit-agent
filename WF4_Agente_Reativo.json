    {
      "parameters": {
        "jsCode": "\n// Normaliza a mensagem recebida do WhatsApp (payload Cloud API).\nconst j=$input.first().json;\nlet phone=\"\", texto=\"\";\ntry{\n  const v=j.messages ? j : (j.body?.entry?.[0]?.changes?.[0]?.value || j.entry?.[0]?.changes?.[0]?.value || {});\n  const msg=(v.messages && v.messages[0]) || (j.messages && j.messages[0]) || {};\n  phone = msg.from || j.from || \"\";\n  texto = msg.text?.body || j.text?.body || j.message || \"\";\n}catch(e){}\nphone=String(phone).replace(/\\D/g,''); if(phone && !phone.startsWith('55')) phone='55'+phone;\nreturn [{json:{phone, texto}}];\n"
      },
      "id": "35e52fd6-40fc-46af-8cd1-b314db76c3e8",
      "name": "Extrair mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
