    {
      "parameters": {
        "jsCode": "\n// Detecta intenção simples por palavra-chave (opt-out / confirmação).\nconst t=($json.texto||\"\").toLowerCase();\nlet intent=\"conversa\";\nif(/\\b(sair|parar|pare|descadastrar|remover|stop|cancelar)\\b/.test(t)) intent=\"opt_out\";\nelse if(/\\b(confirmo|confirmado|confirmar|vou|estarei|presença|presenca|sim,? vou)\\b/.test(t)) intent=\"confirmar\";\nreturn [{json:{...$json, intent}}];\n"
      },
      "id": "472ce164-0594-41b3-a8f3-7d2915daca0b",
      "name": "Detectar intenção",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        420
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "opt_out",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "opt_out"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "confirmar",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "confirmar"
            }
          ]
        },
        "options": {}
      },
      "id": "ad13ced4-3054-4437-8a79-57a75efbadd5",
      "name": "Rotear intenção",
