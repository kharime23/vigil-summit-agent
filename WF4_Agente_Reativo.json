      "parameters": {
        "jsCode": "\n// Extrai lead_id do booking do Cal.com (link enviado com ?lead=<lead_id>) com fallback por e-mail.\nconst b=$json.body||$json; const p=b.payload||b;\nlet lead_id=\"\", email=\"\", inicio=\"\";\ntry{\n  const resp=p.responses||{}; const md=p.metadata||{};\n  lead_id = md.lead || md.lead_id || resp.lead?.value || resp.lead_id?.value || \"\";\n  email = (p.attendees&&p.attendees[0]&&p.attendees[0].email) || resp.email?.value || \"\";\n  inicio = p.startTime || \"\";\n}catch(e){}\nreturn [{json:{lead_id, email, inicio}}];\n"
      },
