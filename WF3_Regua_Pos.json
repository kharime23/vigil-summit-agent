      "id": "24904bde-4136-4aac-b35f-8fb27f5b041e",
      "name": "Ler Leads (Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        460,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "9etF2WyKhkDu9Msx",
          "name": "marketing004"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\n// Régua PÓS com timing de teste: \"evento\" simulado = inscrição + 1 dia.\n// Após o evento simulado, etapas a cada +10 min. Produção: D+1..D+10.\nconst AGORA = new Date();\nconst MIN=60*1000, DIA=24*60*MIN;\nconst OFF_EVENTO = 1*DIA;   // evento acontece 1 dia após inscrição (teste)\nconst OFF_STEP = 10*MIN;\n\nconst out=[];\nfor (const item of $input.all()){\n  const l=item.json;\n  if(String(l.opt_out).toUpperCase()===\"TRUE\") continue;\n  const status=(l.status||\"\").toUpperCase();\n  if([\"REUNIAO_AGENDADA\",\"DESCARTE\"].includes(status)) continue;\n\n  const criado=l.created_at?new Date(l.created_at):null;\n  if(!criado) continue;\n  const dataEvento=new Date(criado.getTime()+OFF_EVENTO);\n  if(AGORA < dataEvento) continue; // evento ainda não \"aconteceu\"\n\n  const presente = (status===\"PRESENTE\") || String(l.presenca).toUpperCase()===\"TRUE\";\n  const ultima=(l.ultima_etapa_pos||\"\").toUpperCase();\n  const ultimaTs=l.ultima_etapa_pos_ts?new Date(l.ultima_etapa_pos_ts):dataEvento;\n  const interesse=(l.interesse_demo||\"\").toLowerCase();\n\n  let etapa=null;\n  if(presente){\n    if(ultima===\"\"){ if(AGORA-dataEvento>=OFF_STEP) etapa=\"P1\"; }\n    else if(ultima===\"P1\"){ if(AGORA-ultimaTs>=OFF_STEP) etapa=\"P2\"; }\n    else if(ultima===\"P2\"){ if(AGORA-ultimaTs>=OFF_STEP) etapa = (interesse===\"alto\") ? \"P5\" : \"P4\"; }\n    else if(ultima===\"P4\"||ultima===\"P5\"){ if(AGORA-ultimaTs>=OFF_STEP) etapa=\"P6\"; }\n  } else { // no-show\n    if(ultima===\"\"){ if(AGORA-dataEvento>=OFF_STEP) etapa=\"P3\"; }\n    else if(ultima===\"P3\"){ if(AGORA-ultimaTs>=OFF_STEP) etapa=\"P6\"; }\n  }\n  if(!etapa) continue;\n  out.push({json:{...l, etapa, presente, link_reuniao: \"https://cal.com/vigil-ai/demo?lead=\"+encodeURIComponent(l.lead_id)}});\n}\nreturn out;\n"
      },
      "id": "95a93614-efed-46b3-87e8-4dde52367cde",
      "name": "Decidir etapa pós (timing)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Você é o agente comercial do Vigil Summit (Vigil.AI, cibersegurança). Gere a mensagem da régua PÓS-evento para agendar uma reunião comercial, usando toda a memória do lead.\n\nETAPA A GERAR: {{ $json.etapa }}\nLINK DE AGENDAMENTO (Cal.com): {{ $json.link_reuniao }}\n\nPERFIL / MEMÓRIA DO LEAD:\n- Nome: {{ $json.nome }} | Cargo: {{ $json.cargo_real || $json.cargo_informado }}\n- Empresa: {{ $json.empresa }} | Setor: {{ $json.setor }} | Porte: {{ $json.porte }}\n- Compareceu ao evento?: {{ $json.presente }}\n- Trilhas vistas: {{ $json.trilhas_vistas }}\n- Interesse em demo: {{ $json.interesse_demo }}\n- Ângulo de personalização: {{ $json.angulo_personalizacao }}\n- Sinais de interesse: {{ $json.sinais_interesse }}\n\nDIRETRIZES POR ETAPA:\n- P1 (D+1, presentes): agradeça a presença, referencie a trilha vista, ofereça próximo passo leve.\n- P2 (oferta de reunião, e-mail+WhatsApp): CTA direto para agendar a demo no link Cal.com; conecte a dor do setor/cargo à plataforma.\n- P3 (no-show): \"sentimos sua falta\", ofereça material/gravação e uma demo 1:1 pelo link.\n- P4 (toque de valor): traga um insight/case do setor do lead; reforce o CTA de agendamento.\n- P5 (WhatsApp quente): nudge pessoal e curto para leads de alto interesse; cite a demo vista.\n- P6 (break-up): mensagem de encerramento respeitosa, com leve escassez, deixando a porta aberta.\n\nREGRAS: PT-BR, tom consultivo e comercial (não agressivo), personalização real, sempre com o link Cal.com quando fizer sentido. Nunca invente dados fora do perfil.\n\nResponda em JSON: assunto, corpo_email (HTML com <p>, inclua o link como <a href>), corpo_whatsapp (curto, com o link em texto).",
        "hasOutputParser": true
      },
