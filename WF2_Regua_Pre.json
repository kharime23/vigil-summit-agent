    {
      "parameters": {
        "jsCode": "\n// Lógica da régua PRÉ com timing de teste comprimido.\n// Produção: trocar os offsets por D-7/D-3/D-1/D0 (ver constantes abaixo).\nconst AGORA = new Date();\nconst MIN = 60*1000, HORA = 60*MIN;\n\n// offsets de TESTE (comprimido p/ o avaliador ver tudo)\nconst OFF_E2 = 1*HORA;   // E2: 1h após inscrição\nconst OFF_STEP = 10*MIN; // E3,E4,E5: 10 min após a etapa anterior\n\nconst out = [];\nfor (const item of $input.all()) {\n  const l = item.json;\n  // pular quem saiu, quem já converteu/descartou, ou sem data\n  if (String(l.opt_out).toUpperCase() === \"TRUE\") continue;\n  const status = (l.status || \"\").toUpperCase();\n  if ([\"REUNIAO_AGENDADA\",\"DESCARTE\",\"PRESENTE\",\"NAO_COMPARECEU\"].includes(status)) continue;\n\n  const criado = l.created_at ? new Date(l.created_at) : null;\n  if (!criado) continue;\n  const ultima = (l.ultima_etapa_pre || \"\").toUpperCase();\n  const ultimaTs = l.ultima_etapa_pre_ts ? new Date(l.ultima_etapa_pre_ts) : criado;\n  const confirmado = String(l.confirmado).toUpperCase() === \"TRUE\";\n\n  let etapa = null;\n  if (ultima === \"\" || ultima === \"E1\") {\n    if (AGORA - criado >= OFF_E2) etapa = \"E2\";\n  } else if (ultima === \"E2\") {\n    if (AGORA - ultimaTs >= OFF_STEP) etapa = \"E3\";\n  } else if (ultima === \"E3\") {\n    if (AGORA - ultimaTs >= OFF_STEP) etapa = \"E4\";\n  } else if (ultima === \"E4\") {\n    if (AGORA - ultimaTs >= OFF_STEP) etapa = \"E5\";\n  }\n  if (!etapa) continue;\n\n  out.push({ json: { ...l, etapa, confirmado } });\n}\nreturn out;\n"
      },
      "id": "a2b9e6a5-890f-401e-bdbf-c700fd6dda7b",
      "name": "Decidir etapa (timing)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
